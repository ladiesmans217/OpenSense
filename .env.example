# Bright Data API token — https://brightdata.com/cp/setting (API tokens section)
BRIGHTDATA_API_TOKEN=

# Telegram digest delivery (talk to @BotFather, then @userinfobot for your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Control plane (python -m pipeline bot) — numeric admin ids, comma separated.
# Get yours by messaging your bot once, then checking
# https://api.telegram.org/bot<TOKEN>/getUpdates  ("chat":{"id":...})
TELEGRAM_ADMIN_IDS=

# Email digest (optional). Either Resend (simpler) or Gmail SMTP (app password).
EMAIL_TO=
EMAIL_FROM=opensense@resend.dev
RESEND_API_KEY=
# SMTP path: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# Optional LLM digest narration (OFF unless NARRATE_API_KEY is set; any
# OpenAI-compatible endpoint). Failure is silent — the rules digest is primary.
NARRATE_API_KEY=
NARRATE_BASE_URL=https://api.openai.com/v1
NARRATE_MODEL=gpt-4o-mini
